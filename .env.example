# Server-side only. Never prefix these with NEXT_PUBLIC_.

# ---- Cloudflare Workers AI (free, no credit card) -------------------------
# The app edits your photo with FLUX.2 [klein], which takes the source photo
# as a reference image. Covered by the free tier (10,000 neurons/day).
# Sign up (GitHub works, no card): https://dash.cloudflare.com
# Create an API token with the "Workers AI" template:
# https://dash.cloudflare.com/profile/api-tokens
# Your account id is shown on the right of the Workers & Pages dashboard.
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Optional model override (any FLUX.2 model on Workers AI works).
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
